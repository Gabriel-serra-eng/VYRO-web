# Copie para .env.local (nunca commitado) e preencha com os valores reais.

# Resend — notificação por e-mail dos leads (somente servidor).
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=VYRO <leads@your-verified-domain.com>
# Opcional: destinatário das notificações (padrão: e-mail de lib/constants/contact.ts).
LEAD_NOTIFICATION_EMAIL=

# Opcional: scripts de marketing, carregados somente após consentimento do usuário.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
